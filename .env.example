# Public Vite names only. Never put the service role key here.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Production smoke (tests/smoke). Names only — values live in GitHub
# secrets / your local environment. Do not commit values.
# SMOKE_BASE_URL=https://your-production-origin
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
# E2E_VIEWER_EMAIL=
# E2E_VIEWER_PASSWORD=
# Integration tests only (never VITE_*): SUPABASE_SERVICE_ROLE_KEY=
# GitHub Actions only (production-smoke.yml apply-schema). Never VITE_*.
# PRODUCTION_SUPABASE_DB_URL=
